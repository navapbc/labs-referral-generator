# This file allows you to specify a list of files that is acceptable to Dockle
# To allow multiple files, use a list of names, example below. Make sure to remove the leading #
# DOCKLE_ACCEPT_FILES=file1,path/to/file2,file3/path,etc
# https://github.com/goodwithtech/dockle#accept-suspicious-environment-variables--files--file-extensions

# settings.py: library modules in the virtualenv (hayhooks, phoenix, scipy, python-docx,
# trafilatura, ...) named settings.py, which Dockle flags by filename only. Matching on the
# filename keeps this working across Python version upgrades.
DOCKLE_ACCEPT_FILES=settings.py

# python:3.13-slim doesn't clear package caches after apt-get install; we do so in our own Dockerfile
DOCKLE_IGNORES=DKL-DI-0005
